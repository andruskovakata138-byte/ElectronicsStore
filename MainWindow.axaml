<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ElectronicsStore.Views.MainWindow" Title="Магазин электроники" Width="1150" Height="780" MinWidth="900" MinHeight="600">
<DockPanel Margin="20"><StackPanel DockPanel.Dock="Top" Spacing="10"><TextBlock Text="МАГАЗИН ЭЛЕКТРОНИКИ" FontSize="25" FontWeight="Bold" Foreground="#1565C0"/><TextBlock x:Name="Identity"/><WrapPanel x:Name="Navigation" Orientation="Horizontal"/><TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="#B3261E" Margin="0,8"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Page" Spacing="12"/></ScrollViewer></DockPanel></Window>
