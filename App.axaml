<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ElectronicsStore.App" RequestedThemeVariant="Light">
<Application.Styles><FluentTheme/><Style Selector="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#F4F6F8"/></Style><Style Selector="Button"><Setter Property="Padding" Value="14,8"/></Style><Style Selector="TextBox"><Setter Property="MinWidth" Value="180"/></Style></Application.Styles></Application>
